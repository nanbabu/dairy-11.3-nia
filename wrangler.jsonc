{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dairy-9-10",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "PAYMENTS_ENABLED": "false"
  },
  "ai": {
    "binding": "AI"
  }
}
